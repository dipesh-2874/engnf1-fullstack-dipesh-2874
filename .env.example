# MongoDB Atlas URI or a local replica set for transaction support.
MONGO_URI=mongodb://127.0.0.1:27017/triagesync?replicaSet=rs0
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
SERVE_FRONTEND=false
JWT_EXPIRES_IN=timeh

# Public API URL baked into the frontend. Use /api for a same-origin build.
VITE_API_BASE_URL=http://localhost:5000/api
